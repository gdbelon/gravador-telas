# Configurações do Backend BPMN Process Recorder

# Chave de API do Google Gemini (obrigatório para análise multimodal e BPMN)
GEMINI_API_KEY=AIzaSy...

# URL do Banco de Dados (Padrão: SQLite local. Exemplo PostgreSQL: postgresql://user:pass@localhost:5432/bpmn_db)
DATABASE_URL=sqlite:///./processos.db

# Host e Porta da API
HOST=0.0.0.0
PORT=8000

# URL pública ou base do serviço (utilizada para gerar o link do viewer retornado à extensão)
BASE_URL=http://localhost:8000
